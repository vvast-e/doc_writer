# .gitignore
__pycache__/
chrome-profile/
chrome-profile1/
*.pyc
*.pyo
*.pyd
*.log
*.db
*.sqlite
*.bak
*.tmp
*.swp
*.swo
*.~
.DS_Store
Thumbs.db
.env
venv/

# PyInstaller build artifacts
build/
dist/
*.spec

# Bundled Chromium (too large for GitHub)
humantype-tauri/src-tauri/resources/chromium/
humantype-tauri/src-tauri/resources/python-script.exe

# Rust / Tauri build artifacts
target/
src-tauri/target/

# Node modules
node_modules/

# Игнорировать временные и кэш-файлы
*.cache
*.egg-info/

# Игнорировать Jupyter
*.ipynb_checkpoints

# Игнорировать HTML (кроме index.html)
!humantype-tauri/index.html

# Игнорировать тестовые и временные файлы
*.test

# Игнорировать личные настройки
.vscode/
.idea/
