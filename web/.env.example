# Postgres (used by docker-compose.yml to configure the postgres service)
POSTGRES_USER=humantype
POSTGRES_PASSWORD=change-me
POSTGRES_DB=humantype

# Prisma / app database connection.
# When running via docker-compose, this is derived from the POSTGRES_* vars above
# and overridden to point at the "postgres" service — no need to set it here.
# For local (non-docker) development, set it explicitly:
DATABASE_URL=postgresql://humantype:change-me@localhost:5432/humantype

APP_BASE_URL=http://localhost:3000

# OAuth providers (stubs for future phases)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# YooKassa (stubs for future phases)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
