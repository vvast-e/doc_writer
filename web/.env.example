# Postgres (used by docker-compose.yml to configure the postgres service)
POSTGRES_USER=humantype
POSTGRES_PASSWORD=change-me
POSTGRES_DB=humantype

# Prisma / app database connection.
# When running via docker-compose, this is derived from the POSTGRES_* vars above
# and overridden to point at the "postgres" service — no need to set it here.
# For local (non-docker) development, set it explicitly:
DATABASE_URL=postgresql://humantype:change-me@localhost:5432/humantype

# Local dev default; production (VDS, behind the "caddy" service in docker-compose.yml) uses:
# APP_BASE_URL=https://humantype.ru
APP_BASE_URL=http://localhost:3000

# Signs the htsession auth cookie (HMAC-SHA256). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "true" only once a reverse proxy in front of this app is confirmed to strip any
# client-supplied X-Forwarded-For/X-Real-IP and set its own — otherwise those headers are
# spoofable and rate-limiting-by-IP becomes a no-op. Leave unset/false to rate-limit globally.
# Production should set this to "true" once the "caddy" service (docker-compose.yml) is live —
# Caddy is the trusted reverse proxy and sets its own X-Forwarded-For.
TRUST_PROXY=false

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
# Not used by src/backend/modules/oauth/vk.ts — VK ID's server-side flow is PKCE-only,
# no client_secret in the token exchange. Kept here only in case that ever changes.
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Optional — defaults to https://api.yookassa.ru/v3 in code.
YOOKASSA_API_URL=https://api.yookassa.ru/v3
